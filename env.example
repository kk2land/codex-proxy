# Copy to <system account home>/.codex-proxy/env; use a native ELF/Mach-O path.
CODEX_PROXY_REAL_BIN=/absolute/path/to/native/codex
# App-server is rejected unless explicitly enabled in this file.
CODEX_PROXY_APP_SERVER_ENABLED=false
# Exit fake codex and its app-server child after this long without work; 0 disables.
CODEX_PROXY_APP_SERVER_IDLE_TIMEOUT=10m
CODEX_PROXY_MAX_CONCURRENCY=1
CODEX_PROXY_WAIT_TIMEOUT=10m
# Absolute file paths; omitted or empty values keep .codex-proxy/state.lock and state.json.
# Create parent directories first. Restart all proxies before changing these paths.
CODEX_PROXY_STATE_LOCK_PATH=
CODEX_PROXY_STATE_PATH=
# Optional shared account pool. Only auth[0-9]+_<account name>.json regular files.
# Empty disables rotation; restart proxy connections after changing this path.
CODEX_PROXY_AUTH_DIR=
# Logs are single-line text key=value records; there is no format option.
CODEX_PROXY_LOG_MAX_SIZE_MIB=10
CODEX_PROXY_LOG_MAX_BACKUPS=5
